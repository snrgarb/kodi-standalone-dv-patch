# CB1 stack for CachyOS: libplacebo pinned and patched as in LibreELEC-DV
# (CroqueMr/libreelec-x86-dv, packages/addons/addon-depends/multimedia-tools-depends/libplacebo).
# Installed under /opt/cb1 so the system libplacebo (mpv etc.) is untouched.
pkgname=cb1-libplacebo
_commit=e2972fdd09adacd383656738d7d280f0cd84a761
pkgver=7.372.0
pkgrel=1
pkgdesc='libplacebo with the CB1 Dolby Vision patches, installed under /opt/cb1'
arch=('x86_64')
url='https://github.com/haasn/libplacebo'
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'libglvnd')
makedepends=('meson' 'ninja' 'fast_float' 'glad' 'python-jinja' 'python-markupsafe' 'vulkan-headers')
source=("libplacebo-${_commit}.tar.gz::https://github.com/haasn/libplacebo/archive/${_commit}.tar.gz"
