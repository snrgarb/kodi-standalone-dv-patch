prepare() {
  cd "libplacebo-${_commit}"
  local p
  for p in "${source[@]}"; do
    [[ $p == *.patch ]] || continue
    echo "Applying ${p}"
    patch -Np1 -i "../${p}"
  done
}

build() {
  arch-meson "libplacebo-${_commit}" build \
    --prefix=/opt/cb1 --libdir=lib --auto-features=auto -Dopengl=enabled \
    -Ddefault_library=shared -Dprefer_static=true \
    -Dvulkan=disabled -Dvk-proc-addr=disabled -Dd3d11=disabled \
    -Dglslang=disabled -Dshaderc=disabled -Dlcms=disabled \
    -Ddovi=enabled -Dlibdovi=disabled -Ddemos=false -Dtests=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  # As LibreELEC: C++ runtime is needed by static consumers of the .pc file.
  sed 's/^Libs:.*-lplacebo/& -lstdc++/' -i "$pkgdir/opt/cb1/lib/pkgconfig/libplacebo.pc"
}
