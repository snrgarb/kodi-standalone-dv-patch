noextract=("kodi-${_commit}.tar.gz" "libdvdcss-1.5.0.tar.xz" "libdvdnav-7.0.0.tar.xz" "libdvdread-7.0.1.tar.xz" "crossguid-ca1bf4b810e2d188d04cb6286f957008ee1b7681.tar.gz" "libfstrcmp-0.7.D001.tar.gz" "libudfread-1.2.0.tar.gz")
