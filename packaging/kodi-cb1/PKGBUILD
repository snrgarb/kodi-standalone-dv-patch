# Not applied: LibreELEC's 1007-handle-SIGTERM. On LibreELEC systemd owns Kodi's lifetime, so the
# patch makes Exit only record an exit code. On a desktop that leaves Kodi running after Exit.

prepare() {
  rm -rf xbmc-${_commit}
  bsdtar -xf "kodi-${_commit}.tar.gz"
  cd "xbmc-${_commit}"
  local p
  for p in "${source[@]}"; do
    [[ $p == *.patch ]] || continue
    echo "Applying ${p}"
    patch -Np1 -i "../${p}"
  done
}

build() {
  export PKG_CONFIG_PATH=/opt/cb1/lib/pkgconfig
  export LDFLAGS+=" -Wl,-rpath,/opt/cb1/lib"
  local s="$srcdir"
  # libdvd*/udfread/crossguid/fstrcmp: upstream tarballs (as LibreELEC), not Kodi-mirror
  # repacks, so their SHA256 is pinned via *_HASH below.
  cmake -S "xbmc-${_commit}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/cb1 \
    -DCMAKE_INSTALL_LIBDIR=/opt/cb1/lib \
    -DENABLE_DVBRIDGE=ON \
    '-DCORE_COMPILE_OPTIONS=-Werror=missing-field-initializers;-Werror=sign-compare' \
    -DDVBRIDGE_SOURCE_DIR="$s/cb1/src" \
    -DGIT_VERSION=${_commit} \
    -DFFMPEG_PATH=/opt/cb1 \
    -DENABLE_INTERNAL_FFMPEG=OFF \
    -DENABLE_INTERNAL_EXIV2=OFF \
    -DENABLE_INTERNAL_FLATBUFFERS=OFF \
    -DENABLE_INTERNAL_MARIADBCLIENT=OFF \
    -DENABLE_INTERNAL_SPDLOG=OFF \
    -DENABLE_INTERNAL_CROSSGUID=ON -DCROSSGUID_URL="$s/crossguid-ca1bf4b810e2d188d04cb6286f957008ee1b7681.tar.gz" \
    -DENABLE_INTERNAL_FSTRCMP=ON -DFSTRCMP_URL="$s/libfstrcmp-0.7.D001.tar.gz" \
    -DENABLE_INTERNAL_UDFREAD=ON -DUDFREAD_URL="$s/libudfread-1.2.0.tar.gz" \
    -DENABLE_UDEV=ON -DENABLE_DBUS=ON -DENABLE_XSLT=ON -DENABLE_CCACHE=OFF \
    -DENABLE_LIRCCLIENT=OFF -DENABLE_EVENTCLIENTS=ON -DENABLE_DEBUGFISSION=OFF -DENABLE_APP_AUTONAME=OFF \
    -DENABLE_TESTING=OFF -DENABLE_BLUETOOTH=OFF -DENABLE_LCMS2=OFF -DADDONS_CONFIGURE_AT_STARTUP=OFF \
    -Dgroovy_SOURCE_DIR="$s/groovy-4.0.33" \
    -Dapache-commons-lang_SOURCE_DIR="$s/commons-lang3-3.20.0" \
    -Dapache-commons-text_SOURCE_DIR="$s/commons-text-1.15.0" \
    -DWITH_CPU=x86_64 \
    -DENABLE_GOLD=OFF -DENABLE_MOLD=OFF \
    -DENABLE_VAAPI=ON -DENABLE_CEC=ON \
    -DCORE_PLATFORM_NAME=gbm -DAPP_RENDER_SYSTEM=gles \
    -DENABLE_SMBCLIENT=ON -DENABLE_NFS=ON \
    -DENABLE_DVDCSS=ON \
    -DLIBDVDCSS_URL="$s/libdvdcss-1.5.0.tar.xz" \
    -DLIBDVDNAV_URL="$s/libdvdnav-7.0.0.tar.xz" \
    -DLIBDVDREAD_URL="$s/libdvdread-7.0.1.tar.xz" \
    -DLIBDVDCSS_HASH=SHA256=529463e4d1befef82e5c6e470db7661a2db0343e092a2fb0d6c037cab8a5c399 \
    -DLIBDVDNAV_HASH=SHA256=a2a18f5ad36d133c74bf9106b6445806fa253b09141a46392550394b647b221e \
    -DLIBDVDREAD_HASH=SHA256=2e3e04a305c15c3963aa03ae1b9a83c1d239880003fcf3dde986d3943355d407 \
    -DUDFREAD_HASH=SHA256=adcce1190925f9d35a477757c5e3f0e221315d14d3d45b4ae62540ea0925f877 \
    -DCROSSGUID_HASH=SHA256=6be27e0b3a4907f0cd3cfadec255ee1b925569e1bd06e67a4d2f4267299b69c4 \
    -DFSTRCMP_HASH=SHA256=e4018e850f80700acee8da296e56e15b1eef711ab15157e542e7d7e1237c3476 \
    -DENABLE_AVAHI=ON -DENABLE_UPNP=ON \
    -DENABLE_MARIADBCLIENT=ON -DENABLE_MYSQLCLIENT=OFF \
    -DENABLE_PLIST=ON \
    -DENABLE_AIRTUNES=OFF \
    -DENABLE_OPTICAL=ON -DENABLE_BLURAY=ON \
    -DENABLE_ALSA=ON -DENABLE_PULSEAUDIO=ON -DENABLE_PIPEWIRE=OFF \
    -DCB1_ENABLE_HDR10_AI=ON \
    -DCB1_L1L3_BUNDLE_CONTRACT="$s/cb1-model/contract" \
    -DCB1_LIGHTGBM_INCLUDE_DIR=/opt/cb1/include \
    -DCB1_LIGHTGBM_LIBRARY=/opt/cb1/lib/lib_lightgbm.so
  # Not carried over from LibreELEC: toolchain/sysroot paths, gold+LTO (gold rejects
  # makepkg's -z pack-relative-relocs; Arch's kodi disables it too), static PCRE2,
  # prebuilt TexturePacker/JsonSchemaBuilder (Kodi builds its own natively),
  # AirTunes (libshairplay is not packaged on Arch).
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # CB1's HDR10 AI model: Kodi looks in /usr/share/cb1/l1l3 (compile-time default).
  install -dm755 "$pkgdir/usr/share/cb1/l1l3"
  cp "$srcdir"/cb1-model/data/* "$pkgdir/usr/share/cb1/l1l3/"
  install -Dm644 "$srcdir/cb1-model/LICENSE.md" "$pkgdir/usr/share/cb1/l1l3/LICENSE.md"
  # Plasma Bigscreen hand-off: Kodi on tty7 with exclusive KMS, back to Plasma on exit.
  install -Dm644 "$srcdir/kodi-cb1@.service" "$pkgdir/usr/lib/systemd/system/kodi-cb1@.service"
  install -Dm755 "$srcdir/return-to-desktop" "$pkgdir/opt/cb1/lib/kodi-cb1/return-to-desktop"
  install -Dm755 "$srcdir/kodi-cb1-launch" "$pkgdir/opt/cb1/bin/kodi-cb1-launch"
  install -Dm644 "$srcdir/50-kodi-cb1.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-kodi-cb1.rules"
  install -Dm644 "$srcdir/kodi-cb1.desktop" "$pkgdir/usr/share/applications/kodi-cb1.desktop"
  # CB1 dialogs (enhanced player info, playback modes): LibreELEC-DV ships these in its
  # filesystem overlay, not in the Kodi tree. Kodi loads them from special://xbmc/media/.
  install -Dm644 -t "$pkgdir/opt/cb1/share/kodi/media" "$srcdir/cb1-white.png" "$srcdir/cb1-panel.png"
  install -Dm644 -t "$pkgdir/opt/cb1/share/kodi/media/cb1" "$srcdir/DialogPlayerProcessInfo.xml" \
    "$srcdir/IncludesDVProcessInfo.xml" "$srcdir/DialogPlaybackModes.xml"
}
