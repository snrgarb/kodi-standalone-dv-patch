#!/bin/sh
# Switch back to the user's graphical (Plasma) session after Kodi exits.
user="$1"
for s in $(loginctl list-sessions --no-legend | awk -v u="$user" '$3 == u {print $1}'); do
  [ "$(loginctl show-session "$s" -p Type --value)" = wayland ] || continue
  vt=$(loginctl show-session "$s" -p VTNr --value)
  [ -n "$vt" ] && [ "$vt" != 0 ] && exec chvt "$vt"
done
exec chvt 1
