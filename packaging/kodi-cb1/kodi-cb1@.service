# Kodi CB1 on its own VT with exclusive KMS (needed for the Dolby Vision HDMI properties).
# Started from Plasma Bigscreen via kodi-cb1-launch; Plasma keeps running on its own VT.
[Unit]
Description=Kodi CB1 (GBM, native Dolby Vision) for %i
After=systemd-user-sessions.service
Conflicts=getty@tty7.service

[Service]
User=%i
PAMName=login
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty7
ExecStartPre=+/usr/bin/chvt 7
ExecStartPre=+/opt/cb1/lib/kodi-cb1/wait-for-display
ExecStart=/opt/cb1/lib/kodi-cb1/reserve-hdmi-audio /opt/cb1/bin/kodi-standalone
# Kodi runs in the login session scope, not in this unit: end the session, then go back to Plasma.
ExecStopPost=+/opt/cb1/lib/kodi-cb1/stop-session tty7
ExecStopPost=+/opt/cb1/lib/kodi-cb1/return-to-desktop %i
TimeoutStopSec=60
Restart=no
# ALSA gives TrueHD/DTS-HD passthrough and no PulseAudio buffering delay. PulseAudio stays
# available for other outputs (e.g. headphones). Select the ALSA HDMI device in Kodi's settings.
Environment=KODI_AE_SINK=ALSA+PULSE

[Install]
WantedBy=multi-user.target
