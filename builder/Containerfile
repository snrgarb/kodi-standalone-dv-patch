FROM docker.io/cachyos/cachyos:latest
RUN pacman -Syu --noconfirm --needed base-devel git bc binutils cpio gettext glibc libelf libgcc openssl pahole perl python rust rust-bindgen rust-src tar xxhash xz zstd clang llvm lld gnupg \
      cmake ninja meson nasm && \
    useradd -u 1001 -m builder && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder && \
    pacman -Scc --noconfirm
COPY cb1-makepkg.conf /etc/makepkg.conf.d/cb1.conf
USER builder
WORKDIR /build
